# Copy to .env for local (non-Docker) work. docker-compose.yml already sets sensible defaults,
# so `docker compose up --build` needs no .env.

# Postgres (docker-compose db service)
POSTGRES_USER=zenly
POSTGRES_PASSWORD=zenly
POSTGRES_DB=zenly

# App database connection.
#  - inside Docker Compose, host is the service name "db" on port 5432
#  - for local CLI against the Compose DB, use localhost:5433
DATABASE_URL=postgresql://zenly:zenly@db:5432/zenly?schema=public

# Session cookie (custom auth, added in later steps)
SESSION_COOKIE_NAME=zenly_session
SESSION_MAX_AGE=604800

NODE_ENV=production
